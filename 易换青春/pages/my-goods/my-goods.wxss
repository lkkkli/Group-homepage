.container {
  padding: 20rpx;
}
.goods-item {
  display: flex;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}
.goods-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
}
.info {
  flex: 1;
  margin-left: 20rpx;
}
.btn-box {
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.price {
  font-size: 28rpx;
  color: #ff4d4f;
}
.empty-tip {
  text-align: center;
  margin-top: 150rpx;
  font-size: 30rpx;
  color: #999;
}