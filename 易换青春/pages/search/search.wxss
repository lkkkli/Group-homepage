.search-input {
  display: flex;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.search-input input {
  flex: 1;
}
.goods-item {
  display: flex;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}
.goods-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
}
.info {
  flex: 1;
  margin-left: 20rpx;
}