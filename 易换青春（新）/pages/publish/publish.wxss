page {
  background: #f5f5f5;
  padding: 20rpx;
}

.img-wrap {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 30rpx;
}

.img-preview {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.img-add {
  width: 100%;
  height: 100%;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.form-wrap {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item text {
  width: 160rpx;
  color: #333;
}

.form-item input,
.form-item picker {
  flex: 1;
  padding: 10rpx;
  color: #666;
}

.textarea-item {
  align-items: flex-start;
}

.form-item textarea {
  flex: 1;
  height: 160rpx;
  padding: 10rpx;
  color: #666;
}

/* 按钮区域 */
.btn {
  width: 90%;
  height: 88rpx;
  border-radius: 12rpx;
  margin: 0 auto 20rpx; /* 左右auto → 水平居中 */
  padding: 0; /* 清除小程序默认内边距 */
  display: flex;
  align-items: center;
  justify-content: center; /* 文字垂直+水平居中 */
  font-size: 32rpx;
}

.ai-btn {
  background: #07c160;
  color: #fff;
}

.submit-btn {
  background: #1677ff;
  color: #fff;
}