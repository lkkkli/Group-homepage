<view class="search-wrap">
  <!-- 搜索输入框+按钮行 -->
  <view class="search-bar">
    <input class="search-input" placeholder="输入关键词" bindinput="inputKeyword" value="{{keyword}}"/>
    <button class="search-btn" bindtap="doSearch">搜索</button>
  </view>

  <!-- 商品列表 -->
  <view wx:for="{{goodsList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" class="goods-item">
    <image wx:if="{{item.pic}}" src="{{item.pic}}" class="goods-img"/>
    <view class="goods-info">
      <text class="goods-title">{{item.title}}</text>
      <text class="goods-price">¥{{item.price}}</text>
    </view>
  </view>

  <!-- 空状态提示 -->
  <view wx:if="{{goodsList.length === 0}}" class="empty-tip">暂无匹配商品</view>
</view>