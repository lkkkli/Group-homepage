/* 整体容器边距 */
.search-wrap {
  padding: 30rpx;
}

/* 输入框+按钮横向布局 */
.search-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

/* 输入框样式 */
.search-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

/* 彩色搜索按钮（橙色主题，和顶部标题栏统一） */
.search-btn {
  width: 160rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #ff7838;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}
/* 去掉按钮默认灰色边框 */
.search-btn::after {
  border: none;
}

/* 商品条目横向排版 */
.goods-item {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}
.goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
}
.goods-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.goods-title {
  font-size: 32rpx;
  margin-bottom: 12rpx;
}
.goods-price {
  font-size: 32rpx;
  color: #f43f3b;
}

/* 空提示居中美化 */
.empty-tip {
  text-align: center;
  font-size: 30rpx;
  color: #999;
  margin-top: 100rpx;
}